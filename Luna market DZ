        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden text-center py-16 bg-slate-800/20 rounded-3xl border border-slate-800/80 my-8">
            <i class="fa-solid fa-box-open text-6xl text-slate-600 mb-4"></i>
