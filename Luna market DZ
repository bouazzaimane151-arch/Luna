    <!-- ==================== MODALS ==================== -->

    <!-- Admin Login Modal -->
    <div id="loginModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative">
            <button onclick="closeModal('loginModal')" class="absolute top-4 left-4 text-slate-400 hover:text-white text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
            
            <div class="text-center mb-6">
                <div class="w-14 h-14 bg-brand-500/10 border border-brand-500/20 text-brand-400 rounded-2xl flex items-center justify-center mx-auto mb-3">
                    <i class="fa-solid fa-user-shield text-2xl"></i>
                </div>
                <h3 class="text-2xl font-bold text-white">تسجيل دخول المسؤول</h3>
                <p class="text-slate-400 text-xs mt-1">الرجاء إدخال بيانات الاعتماد للتحكم بالموقع</p>
            </div>

            <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5">البريد الإلكتروني</label>
                    <div class="relative">
                        <input type="email" id="loginEmail" required class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500" placeholder="admin@example.com">
                        <i class="fa-solid fa-envelope absolute left-3 top-3.5 text-slate-500 text-sm"></i>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5">كلمة المرور</label>
                    <div class="relative">
                        <input type="password" id="loginPassword" required class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-500" placeholder="••••••••">
                        <i class="fa-solid fa-lock absolute left-3 top-3.5 text-slate-500 text-sm"></i>
                    </div>
                </div>

                <button type="submit" class="w-full bg-brand-600 hover:bg-brand-500 text-white font-bold py-3 rounded-xl transition-all shadow-lg shadow-brand-600/30 text-sm mt-2">
                    تسجيل الدخول
                </button>
            </form>
        </div>
    </div>

    <!-- Add/Upload APK Modal -->
    <div id="addAppModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 max-w-xl w-full shadow-2xl relative max-h-[90vh] overflow-y-auto custom-scrollbar">
            <button onclick="closeModal('addAppModal')" class="absolute top-4 left-4 text-slate-400 hover:text-white text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="flex items-center space-x-3 space-x-reverse mb-6 border-b border-slate-800 pb-4">
                <div class="w-10 h-10 rounded-xl bg-brand-600/20 text-brand-400 flex items-center justify-center">
                    <i class="fa-solid fa-upload text-lg"></i>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">إضافة تطبيق جديدة (APK)</h3>
                    <p class="text-xs text-slate-400">قم بإدخال بيانات التطبيق ورابط الـ APK المباشر</p>
                </div>
            </div>

            <form id="addAppForm" onsubmit="handleAddApp(event)" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">اسم التطبيق *</label>
                        <input type="text" id="appName" required class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-500" placeholder="مثال: واتساب بلس">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">المطور / الشركة *</label>
                        <input type="text" id="appDev" required class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-500" placeholder="مثال: Bouazza Dev">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">التصنيف *</label>
                        <select id="appCategory" required class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-500">
                            <option value="تطبيقات">تطبيقات</option>
                            <option value="ألعاب">ألعاب</option>
                            <option value="أدوات">أدوات ورسومات</option>
                            <option value="إنتاجية">إنتاجية وحماية</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">الإصدار *</label>
                        <input type="text" id="appVersion" placeholder="v1.0.0" required class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">الحجم *</label>
                        <input type="text" id="appSize" placeholder="25 MB" required class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">رابط أيقونة التطبيق (Image URL) *</label>
                    <input type="url" id="appIcon" required class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-500" placeholder="https://example.com/icon.png">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">رابط تحميل ملف الـ APK المباشر *</label>
                    <input type="url" id="appApkUrl" required class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-500" placeholder="https://example.com/myapp.apk">
                    <p class="text-[11px] text-slate-500 mt-1">يمكنك وضع رابط مباشر للملف أو رابط من Google Drive / MediaFire.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">وصف التطبيق</label>
                    <textarea id="appDesc" rows="3" class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-500" placeholder="شرح مختصر لمميزات التطبيق..."></textarea>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 rounded-xl transition-all text-sm shadow-lg shadow-emerald-600/20">
                        <i class="fa-solid fa-cloud-arrow-up ml-2"></i>
                        نشر التطبيق الآن
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- App Details / Download Modal -->
    <div id="appDetailsModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm hidden p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 max-w-lg w-full shadow-2xl relative">
            <button onclick="closeModal('appDetailsModal')" class="absolute top-4 left-4 text-slate-400 hover:text-white text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div id="modalAppContent">
                <!-- Injected via JS -->
            </div>
        </div>
    </div>

    <!-- ==================== JAVASCRIPT LOGIC ==================== -->
    <script>
        // System Admin Credentials Protection
        const ADMIN_EMAIL = "bouazzaimane151@gmail.com";
        const ADMIN_PASS = "Luna123";

        // Initial Sample Data (Store in LocalStorage if not exists)
        const initialApps = [
            {
                id: '1',
                title: 'تطبيق الإدارة والتحكم الذكي',
                developer: 'Bouazza Studio',
                category: 'أدوات',
                version: '2.4.0',
                size: '18 MB',
                downloads: '1.2k',
                rating: '4.9',
                icon: 'https://cdn-icons-png.flaticon.com/512/3522/3522204.png',
                apkUrl: 'https://raw.githubusercontent.com/app-release-demo/sample.apk',
                description: 'تطبيق متقدم يساعدك في تنظيم وإدارة المهام وتصفح الملفات بسرعة عالية وأمان كامل.'
            },
            {
                id: '2',
                title: 'لعبة مغامرات السرعة 3D',
                developer: 'Interactive Games',
                category: 'ألعاب',
                version: '1.0.5',
                size: '85 MB',
                downloads: '5.8k',
                rating: '4.7',
                icon: 'https://cdn-icons-png.flaticon.com/512/686/686589.png',
                apkUrl: 'https://raw.githubusercontent.com/app-release-demo/sample.apk',
                description: 'تجربة سباق ومغامرات حماسية بجرافيكس عالي الجودة وتوافق رائع مع أجهزة أندرويد.'
            },
            {
                id: '3',
                title: 'حزمة الحماية والأمان المتقدمة',
                developer: 'SecuShield',
                category: 'إنتاجية',
                version: '3.1.0',
                size: '12 MB',
                downloads: '3.4k',
                rating: '4.8',
                icon: 'https://cdn-icons-png.flaticon.com/512/2092/2092663.png',
                apkUrl: 'https://raw.githubusercontent.com/app-release-demo/sample.apk',
                description: 'تطبيق حماية فائق للفحص السريع وحماية معلوماتك الشخصية من البرمجيات الخبيثة.'
            }
        ];

        // State Variables
        let apps = [];
        let isAdminLoggedIn = false;
        let currentCategory = 'all';

        // Load Initial State
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('year').textContent = new Date().getFullYear();
            
            // Load Apps
            const savedApps = localStorage.getItem('bouazza_store_apps');
            if (savedApps) {
                apps = JSON.parse(savedApps);
            } else {
                apps = initialApps;
                saveAppsToStorage();
            }

            // Check Auth Session
            const sessionAuth = localStorage.getItem('bouazza_admin_logged');
            if (sessionAuth === 'true') {
                isAdminLoggedIn = true;
            }

            updateUIForAuth();
            renderApps();
        });

        function saveAppsToStorage() {
            localStorage.setItem('bouazza_store_apps', JSON.stringify(apps));
        }

        // Render Apps Grid
        function renderApps(filteredData = null) {
            const listToRender = filteredData || (currentCategory === 'all' 
                ? apps 
                : apps.filter(app => app.category === currentCategory));
            
            const grid = document.getElementById('appsGrid');
            const emptyState = document.getElementById('emptyState');
            const appCountBadge = document.getElementById('appCountBadge');

            appCountBadge.textContent = `${listToRender.length} تطبيق`;
            grid.innerHTML = '';

            if (listToRender.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            listToRender.forEach(app => {
                const card = document.createElement('div');
                card.className = 'glass-card rounded-2xl p-5 flex flex-col justify-between relative group';
                card.innerHTML = `
                    <div>
                        <!-- Top Info -->
                        <div class="flex items-start justify-between mb-4">
                            <img src="${app.icon}" alt="${app.title}" class="w-16 h-16 rounded-2xl object-cover bg-slate-800 border border-slate-700 shadow-md" onerror="this.src='https://cdn-icons-png.flaticon.com/512/2583/2583164.png'">
                            <span class="text-xs bg-slate-800/80 border border-slate-700 text-slate-300 px-2.5 py-1 rounded-lg font-medium">
                                ${app.category}
                            </span>
                        </div>

                        <!-- App Meta -->
                        <h3 class="font-bold text-lg text-white group-hover:text-brand-400 transition-colors line-clamp-1 mb-1">${app.title}</h3>
                        <p class="text-xs text-slate-400 font-medium mb-3">${app.developer}</p>
                        
                        <div class="flex items-center space-x-3 space-x-reverse text-xs text-slate-400 mb-5 border-t border-b border-slate-800/60 py-2.5">
                            <span class="flex items-center"><i class="fa-solid fa-download text-brand-500 ml-1"></i>${app.downloads || '100+'}</span>
                            <span class="flex items-center"><i class="fa-solid fa-hard-drive text-slate-500 ml-1"></i>${app.size}</span>
                            <span class="flex items-center"><i class="fa-solid fa-code-branch text-slate-500 ml-1"></i>${app.version}</span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center justify-between gap-2">
                        <button onclick="openAppDetail('${app.id}')" class="flex-1 bg-brand-600/20 hover:bg-brand-600 text-brand-300 hover:text-white border border-brand-500/30 font-semibold py-2.5 px-3 rounded-xl text-xs transition-all flex items-center justify-center space-x-1 space-x-reverse">
                            <i class="fa-solid fa-eye"></i>
                            <span>التفاصيل والتحميل</span>
                        </button>
                        
                        ${isAdminLoggedIn ? `
                            <button onclick="deleteApp('${app.id}')" class="bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white border border-red-500/20 p-2.5 rounded-xl text-xs transition-all" title="حذف التطبيق">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        ` : ''}
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Category Filter
        function filterCategory(category) {
            currentCategory = category;
            
            // Update Active Tab Styling
            const buttons = document.querySelectorAll('.cat-btn');
            buttons.forEach(btn => {
                if(btn.textContent.trim().includes(category) || (category === 'all' && btn.textContent.trim() === 'الكل')) {
                    btn.className = 'cat-btn active-cat border border-slate-700 px-5 py-2.5 rounded-xl font-semibold text-sm whitespace-nowrap transition-all bg-brand-600 text-white';
                } else {
                    btn.className = 'cat-btn border border-slate-800 bg-slate-800/50 hover:bg-slate-800 text-slate-300 px-5 py-2.5 rounded-xl font-semibold text-sm whitespace-nowrap transition-all';
                }
            });

            renderApps();
        }

        // Search App
        function searchApps() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            filterSearch(query);
        }
        function searchAppsMobile() {
            const query = document.getElementById('mobileSearchInput').value.toLowerCase();
            filterSearch(query);
        }
        function filterSearch(query) {
            const filtered = apps.filter(app => 
                app.title.toLowerCase().includes(query) || 
                app.developer.toLowerCase().includes(query) ||
                app.category.toLowerCase().includes(query)
            );
            renderApps(filtered);
        }

        // Modal Controls
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }
        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        // Admin Auth Logic
        function handleAuthClick() {
            if (isAdminLoggedIn) {
                // Logout
                isAdminLoggedIn = false;
                localStorage.setItem('bouazza_admin_logged', 'false');
                updateUIForAuth();
                showToast('تم تسجيل الخروج بنجاح', 'success');
            } else {
                // Open Login Modal
                openModal('loginModal');
            }
        }

        function handleLogin(e) {
            e.preventDefault();
            const email = document.getElementById('loginEmail').value.trim();
            const password = document.getElementById('loginPassword').value.trim();

            if (email === ADMIN_EMAIL && password === ADMIN_PASS) {
                isAdminLoggedIn = true;
                localStorage.setItem('bouazza_admin_logged', 'true');
                updateUIForAuth();
                closeModal('loginModal');
                showToast('مرحباً بك يا مدير الموقع!', 'success');
                // Reset Form
                document.getElementById('loginForm').reset();
            } else {
                showToast('البريد الإلكتروني أو كلمة المرور غير صحيحة!', 'error');
            }
        }

        function updateUIForAuth() {
            const adminBadge = document.getElementById('adminBadge');
            const addAppBtn = document.getElementById('addAppBtn');
            const authBtnText = document.getElementById('authBtnText');
            const authIcon = document.getElementById('authIcon');

            if (isAdminLoggedIn) {
                adminBadge.classList.remove('hidden');
                adminBadge.classList.add('flex');
                addAppBtn.classList.remove('hidden');
                addAppBtn.classList.add('flex');
                authBtnText.textContent = 'خروج المسؤول';
                authIcon.className = 'fa-solid fa-right-from-bracket text-red-400';
            } else {
                adminBadge.classList.add('hidden');
                adminBadge.classList.remove('flex');
                addAppBtn.classList.add('hidden');
                addAppBtn.classList.remove('flex');
                authBtnText.textContent = 'دخول المسؤول';
                authIcon.className = 'fa-solid fa-right-to-bracket';
            }
            renderApps();
        }

        // Add App Handler (Admin Only)
        function handleAddApp(e) {
            e.preventDefault();
            if (!isAdminLoggedIn) {
                showToast('غير مسموح لك بإجراء هذه العملية!', 'error');
                return;
            }

            const newApp = {
                id: Date.now().toString(),
                title: document.getElementById('appName').value,
                developer: document.getElementById('appDev').value,
                category: document.getElementById('appCategory').value,
                version: document.getElementById('appVersion').value,
                size: document.getElementById('appSize').value,
                downloads: '1+',
                rating: '5.0',
                icon: document.getElementById('appIcon').value,
                apkUrl: document.getElementById('appApkUrl').value,
                description: document.getElementById('appDesc').value || 'لا يوجد وصف حالياً.'
            };

            apps.unshift(newApp);
            saveAppsToStorage();
            renderApps();
            closeModal('addAppModal');
            document.getElementById('addAppForm').reset();
            showToast('تمت إضافة التطبيق بنجاح!', 'success');
        }

        // Delete App (Admin Only)
        function deleteApp(appId) {
            if (!isAdminLoggedIn) return;
            if (confirm('هل أنت تأكد من رغبتك في حذف هذا التطبيق؟')) {
                apps = apps.filter(app => app.id !== appId);
                saveAppsToStorage();
                renderApps();
                showToast('تم حذف التطبيق بنجاح', 'success');
            }
        }

        // Open App Detail Modal
        function openAppDetail(appId) {
            const app = apps.find(a => a.id === appId);
            if (!app) return;

            const content = document.getElementById('modalAppContent');
            content.innerHTML = `
                <div class="flex items-center space-x-4 space-x-reverse mb-6">
                    <img src="${app.icon}" class="w-20 h-20 rounded-2xl object-cover bg-slate-800 border border-slate-700 shadow-md" onerror="this.src='https://cdn-icons-png.flaticon.com/512/2583/2583164.png'">
                    <div>
                        <h2 class="text-xl font-black text-white mb-1">${app.title}</h2>
                        <p class="text-xs text-brand-400 font-semibold mb-2">${app.developer}</p>
                        <span class="inline-block bg-slate-800 text-slate-300 border border-slate-700 px-2.5 py-0.5 rounded text-xs font-semibold">
                            ${app.category}
                        </span>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-2 bg-slate-800/40 rounded-xl p-3 border border-slate-800 text-center mb-6">
                    <div>
                        <span class="block text-[11px] text-slate-400">الإصدار</span>
                        <span class="text-sm font-bold text-slate-200">${app.version}</span>
                    </div>
                    <div class="border-r border-l border-slate-800">
                        <span class="block text-[11px] text-slate-400">الحجم</span>
                        <span class="text-sm font-bold text-slate-200">${app.size}</span>
                    </div>
                    <div>
                        <span class="block text-[11px] text-slate-400">التحميلات</span>
                        <span class="text-sm font-bold text-emerald-400">${app.downloads || '100+'}</span>
                    </div>
                </div>

                <div class="mb-6">
                    <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">عن التطبيق</h4>
                    <p class="text-slate-400 text-sm leading-relaxed max-h-36 overflow-y-auto custom-scrollbar bg-slate-800/20 p-3 rounded-xl border border-slate-800">
                        ${app.description}
                    </p>
                </div>

                <div class="pt-2">
                    <a href="${app.apkUrl}" target="_blank" download class="w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold py-3.5 rounded-xl transition-all shadow-lg shadow-emerald-600/30 flex items-center justify-center space-x-2 space-x-reverse">
                        <i class="fa-solid fa-download text-lg"></i>
                        <span>تحميل ملف APK المباشر</span>
                    </a>
                </div>
            `;

            openModal('appDetailsModal');
        }

        // Custom Toast Notification Function
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toast-message');
            const toastIcon = document.getElementById('toast-icon');

            toastMessage.textContent = message;

            if (type === 'success') {
                toast.className = "fixed bottom-5 left-5 z-50 transform translate-y-0 opacity-100 transition-all duration-300 ease-in-out px-6 py-4 rounded-xl shadow-2xl flex items-center space-x-3 space-x-reverse text-white bg-emerald-600";
                toastIcon.className = "fa-solid fa-circle-check";
            } else {
                toast.className = "fixed bottom-5 left-5 z-50 transform translate-y-0 opacity-100 transition-all duration-300 ease-in-out px-6 py-4 rounded-xl shadow-2xl flex items-center space-x-3 space-x-reverse text-white bg-red-600";
                toastIcon.className = "fa-solid fa-triangle-exclamation";
            }

            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }
    </script>
</body>
</html>
