                <button onclick="filterCategory('ألعاب')" class="cat-btn border border-slate-800 bg-slate-800/50 hover:bg-slate-800 text-slate-300 px-5 py-2.5 rounded-xl font-semibold text-sm whitespace-nowrap transition-all">ألعاب</button>
